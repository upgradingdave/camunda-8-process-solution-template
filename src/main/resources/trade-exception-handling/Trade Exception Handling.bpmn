  <bpmn:process id="Process_0jzoe8m" name="Trade Exception Handling" isExecutable="true">
    <bpmn:serviceTask id="Activity_08my5j8" name="Look up Market Price" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="apiKey" target="authentication.type" />
          <zeebe:input source="query" target="authentication.apiKeyLocation" />
          <zeebe:input source="apiKey" target="authentication.name" />
          <zeebe:input source="=&#34;{{secrets.MASSIVE_API_KEY}}&#34;" target="authentication.value" />
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="=&#34;https://api.massive.com/v2/aggs/ticker/&#34;+symbol+&#34;/range/1/day/&#34;+lastBusinessDay+&#34;/&#34;+lastBusinessDay" target="url" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultVariable" value="marketPriceResult" />
          <zeebe:header key="resultExpression" value="=if response.body.queryCount &#62;= 1 then {&#10;  &#34;quote&#34;: {&#10;    &#34;symbol&#34;: string(response.body.ticker),&#10;    &#34;open&#34;: decimal(response.body.results[1].o, 2),&#10;    &#34;high&#34;: decimal(response.body.results[1].h, 2),&#10;    &#34;low&#34;: decimal(response.body.results[1].l, 2),&#10;    &#34;close&#34;: decimal(response.body.results[1].c, 2),&#10;    &#34;volume&#34;: response.body.results[1].v&#10;  }&#10;} else {&#10;    &#34;quote&#34;: {&#10;    &#34;symbol&#34;: &#34;ERROR&#34;,&#10;    &#34;open&#34;: 1.00,&#10;    &#34;high&#34;: 1.00,&#10;    &#34;low&#34;: 1.00,&#10;    &#34;close&#34;: 1.00,&#10;    &#34;volume&#34;: 0&#10;  }&#10;}" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_15oys55</bpmn:incoming>
      <bpmn:incoming>Flow_0xe6cua</bpmn:incoming>
      <bpmn:outgoing>Flow_0m1w7w6</bpmn:outgoing>
    </bpmn:serviceTask>
