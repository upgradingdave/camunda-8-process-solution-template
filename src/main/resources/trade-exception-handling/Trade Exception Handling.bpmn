    <bpmn:scriptTask id="Activity_0uk00y1" name="Generate unique id">
      <bpmn:extensionElements>
        <zeebe:script expression="={ &#10;  ts: string((now() - date and time(&#34;1970-01-01T00:00Z&#34;)) / duration(&#34;PT1S&#34;) * 1000),&#10;  random: string(floor(random number()*1000)),&#10;  formatted: ts + random&#10;}.formatted" resultVariable="tradeId" />
