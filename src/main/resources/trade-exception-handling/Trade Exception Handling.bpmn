    <bpmn:scriptTask id="Activity_0y11v2e" name="Calcluate most recent business day">
      <bpmn:extensionElements>
        <zeebe:script expression="={&#10;  today: today() - duration(&#34;P10D&#34;),&#10;  dayOfWeek: day of week(today),&#10;  lastBusinessDay: if dayOfWeek = &#34;Saturday&#34; then&#10;                     today - duration(&#34;P1D&#34;)&#10;                   else if dayOfWeek = &#34;Sunday&#34; then&#10;                     today - duration(&#34;P2D&#34;)&#10;                   else&#10;                     today&#10;}.lastBusinessDay" resultVariable="lastBusinessDay" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0sqmj6i</bpmn:incoming>
      <bpmn:outgoing>Flow_0df1v9t</bpmn:outgoing>
    </bpmn:scriptTask>
