<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="ecd7c55" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="PaymentProcessingCardAuthorizationProcess" name="Payment Processing - Card Authorization" isExecutable="true">
    <bpmn:startEvent id="StartEvent_AuthorizationRequestReceived" name="Authorization request received">
      <bpmn:outgoing>Flow_StartToSubmit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_SubmitAndRouteTransaction" name="Submit and route transaction">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="benchmark-task-1" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToSubmit</bpmn:incoming>
      <bpmn:outgoing>Flow_SubmitToSubProcess</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="SubProcess_ParallelChecks" name="Parallel checks (300ms SLA)">
      <bpmn:incoming>Flow_SubmitToSubProcess</bpmn:incoming>
      <bpmn:outgoing>Flow_SubProcessToAuthorize</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent_ParallelChecks" name="Start parallel checks">
        <bpmn:outgoing>Flow_ParallelStart_to_Split</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:parallelGateway id="ParallelGateway_Split" name="">
        <bpmn:incoming>Flow_ParallelStart_to_Split</bpmn:incoming>
        <bpmn:outgoing>Flow_SplitToFraud</bpmn:outgoing>
        <bpmn:outgoing>Flow_SplitToAML</bpmn:outgoing>
        <bpmn:outgoing>Flow_SplitToBalance</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:serviceTask id="Task_DetectFraud" name="Detect fraud">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="benchmark-task-2" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_SplitToFraud</bpmn:incoming>
        <bpmn:outgoing>Flow_FraudToJoin</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_ScreenForAML" name="Screen for AML">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="benchmark-task-3" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_SplitToAML</bpmn:incoming>
        <bpmn:outgoing>Flow_AMLToJoin</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_VerifyAccountBalance" name="Verify account balance">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="benchmark-task-4" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_SplitToBalance</bpmn:incoming>
        <bpmn:outgoing>Flow_BalanceToJoin</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:parallelGateway id="ParallelGateway_Join" name="">
        <bpmn:incoming>Flow_FraudToJoin</bpmn:incoming>
        <bpmn:incoming>Flow_AMLToJoin</bpmn:incoming>
        <bpmn:incoming>Flow_BalanceToJoin</bpmn:incoming>
        <bpmn:outgoing>Flow_JoinToParallelEnd</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:endEvent id="EndEvent_ParallelChecks" name="Parallel checks complete">
        <bpmn:incoming>Flow_JoinToParallelEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_ParallelStart_to_Split" sourceRef="StartEvent_ParallelChecks" targetRef="ParallelGateway_Split" />
      <bpmn:sequenceFlow id="Flow_SplitToFraud" sourceRef="ParallelGateway_Split" targetRef="Task_DetectFraud" />
      <bpmn:sequenceFlow id="Flow_SplitToAML" sourceRef="ParallelGateway_Split" targetRef="Task_ScreenForAML" />
      <bpmn:sequenceFlow id="Flow_SplitToBalance" sourceRef="ParallelGateway_Split" targetRef="Task_VerifyAccountBalance" />
      <bpmn:sequenceFlow id="Flow_FraudToJoin" sourceRef="Task_DetectFraud" targetRef="ParallelGateway_Join" />
      <bpmn:sequenceFlow id="Flow_AMLToJoin" sourceRef="Task_ScreenForAML" targetRef="ParallelGateway_Join" />
      <bpmn:sequenceFlow id="Flow_BalanceToJoin" sourceRef="Task_VerifyAccountBalance" targetRef="ParallelGateway_Join" />
      <bpmn:sequenceFlow id="Flow_JoinToParallelEnd" sourceRef="ParallelGateway_Join" targetRef="EndEvent_ParallelChecks" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="BoundaryEvent_SlaTimer" name="300ms SLA breached" attachedToRef="SubProcess_ParallelChecks">
      <bpmn:outgoing>Flow_Timer_to_TriggerComp</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDef_SlaTimer">
        <bpmn:timeDuration>PT0.3S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_SlaTimeout_TriggerCompensation" name="Trigger compensation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="benchmark-task-5" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Timer_to_TriggerComp</bpmn:incoming>
      <bpmn:outgoing>Flow_TriggerComp_to_BuildDecline</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SlaTimeout_BuildDeclineResponse" name="Build timeout decline response">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="benchmark-task-6" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_TriggerComp_to_BuildDecline</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildDecline_to_Publish</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SlaTimeout_PublishTimeoutEvent" name="Publish timeout event">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="benchmark-task-9" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_BuildDecline_to_Publish</bpmn:incoming>
      <bpmn:outgoing>Flow_Publish_to_TimeoutEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_SlaTimeout" name="Authorization declined (SLA timeout)">
      <bpmn:incoming>Flow_Publish_to_TimeoutEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="Task_AuthorizeTransaction" name="Authorize transaction">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="authorization-decision" resultVariable="authorizeTransactionResult" />
        <zeebe:ioMapping>
          <zeebe:input source="=fraudAction" target="fraudAction" />
          <zeebe:input source="=amlResult" target="amlResult" />
          <zeebe:input source="=sufficientFunds" target="sufficientFunds" />
          <zeebe:input source="=accountStatus" target="accountStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SubProcessToAuthorize</bpmn:incoming>
      <bpmn:outgoing>Flow_AuthorizeToGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Authorized" name="Authorized?" default="SequenceFlow_AuthorizedApproved">
      <bpmn:incoming>Flow_AuthorizeToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AuthorizedApproved</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AuthorizedDeclined</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SendAuthorizationResponse" name="Send authorization response">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="benchmark-task-7" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_AuthorizedApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_ResponseToApprovedEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_AuthorizationApproved" name="Authorization approved">
      <bpmn:incoming>Flow_ResponseToApprovedEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_DeclineAndReleaseEarmark" name="Decline and release earmark">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="benchmark-task-8" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_AuthorizedDeclined</bpmn:incoming>
      <bpmn:outgoing>Flow_DeclineToDeclinedEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_AuthorizationDeclined" name="Authorization declined">
      <bpmn:incoming>Flow_DeclineToDeclinedEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StartToSubmit" sourceRef="StartEvent_AuthorizationRequestReceived" targetRef="Task_SubmitAndRouteTransaction" />
    <bpmn:sequenceFlow id="Flow_SubmitToSubProcess" sourceRef="Task_SubmitAndRouteTransaction" targetRef="SubProcess_ParallelChecks" />
    <bpmn:sequenceFlow id="Flow_SubProcessToAuthorize" sourceRef="SubProcess_ParallelChecks" targetRef="Task_AuthorizeTransaction" />
    <bpmn:sequenceFlow id="Flow_Timer_to_TriggerComp" sourceRef="BoundaryEvent_SlaTimer" targetRef="Task_SlaTimeout_TriggerCompensation" />
    <bpmn:sequenceFlow id="Flow_TriggerComp_to_BuildDecline" sourceRef="Task_SlaTimeout_TriggerCompensation" targetRef="Task_SlaTimeout_BuildDeclineResponse" />
    <bpmn:sequenceFlow id="Flow_BuildDecline_to_Publish" sourceRef="Task_SlaTimeout_BuildDeclineResponse" targetRef="Task_SlaTimeout_PublishTimeoutEvent" />
    <bpmn:sequenceFlow id="Flow_Publish_to_TimeoutEnd" sourceRef="Task_SlaTimeout_PublishTimeoutEvent" targetRef="EndEvent_SlaTimeout" />
    <bpmn:sequenceFlow id="Flow_AuthorizeToGateway" sourceRef="Task_AuthorizeTransaction" targetRef="Gateway_Authorized" />
    <bpmn:sequenceFlow id="SequenceFlow_AuthorizedApproved" name="Approved" sourceRef="Gateway_Authorized" targetRef="Task_SendAuthorizationResponse" />
    <bpmn:sequenceFlow id="SequenceFlow_AuthorizedDeclined" name="Declined" sourceRef="Gateway_Authorized" targetRef="Task_DeclineAndReleaseEarmark">
      <bpmn:conditionExpression>=authorizationDecision = "DECLINED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ResponseToApprovedEnd" sourceRef="Task_SendAuthorizationResponse" targetRef="EndEvent_AuthorizationApproved" />
    <bpmn:sequenceFlow id="Flow_DeclineToDeclinedEnd" sourceRef="Task_DeclineAndReleaseEarmark" targetRef="EndEvent_AuthorizationDeclined" />
    <bpmn:textAnnotation id="TextAnnotation_Start">
      <bpmn:text>Triggered by: Acquirer authorization switch (ISO 8583 MTI 0100)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Start" associationDirection="None" sourceRef="StartEvent_AuthorizationRequestReceived" targetRef="TextAnnotation_Start" />
    <bpmn:textAnnotation id="TextAnnotation_ApprovedEnd">
      <bpmn:text>Follow-up: Settlement batch; issuer ledger credit; Kafka event published to payment.authorization.events</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_ApprovedEnd" associationDirection="None" sourceRef="EndEvent_AuthorizationApproved" targetRef="TextAnnotation_ApprovedEnd" />
    <bpmn:textAnnotation id="TextAnnotation_DeclinedEnd">
      <bpmn:text>Follow-up: Earmark released; reversal event published to payment.reversal.events; MTI 0110 decline response sent to acquirer</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_DeclinedEnd" associationDirection="None" sourceRef="EndEvent_AuthorizationDeclined" targetRef="TextAnnotation_DeclinedEnd" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_PaymentProcessingCardAuthorizationProcess">
    <bpmndi:BPMNPlane id="BPMNPlane_PaymentProcessingCardAuthorizationProcess" bpmnElement="PaymentProcessingCardAuthorizationProcess">
