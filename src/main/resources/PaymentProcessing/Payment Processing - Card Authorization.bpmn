        <bpmndi:BPMNLabel>
          <dc:Bounds x="1253" y="225" width="48" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_AuthorizedDeclined_di" bpmnElement="SequenceFlow_AuthorizedDeclined">
        <di:waypoint x="1222" y="275" />
        <di:waypoint x="1222" y="380" />
        <di:waypoint x="1307" y="380" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1216" y="318" width="43" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ResponseToApprovedEnd_di" bpmnElement="Flow_ResponseToApprovedEnd">
        <di:waypoint x="1407" y="250" />
        <di:waypoint x="1502" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DeclineToDeclinedEnd_di" bpmnElement="Flow_DeclineToDeclinedEnd">
        <di:waypoint x="1407" y="380" />
