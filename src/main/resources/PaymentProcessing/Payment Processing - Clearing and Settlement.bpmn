<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ClearingSettlement" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="69d2c1a" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:message id="Message_ClearingBatch" name="ClearingBatchReceived" />
  <bpmn:error id="Error_SettlementFailed" name="Settlement Failed" errorCode="SETTLEMENT_FAILED" />
  <bpmn:process id="ClearingAndSettlementProcess" name="Payment Processing - Clearing and Settlement" isExecutable="true">
    <bpmn:serviceTask id="Task_MatchClearingRecord" name="Match clearing record">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="match-clearing-record" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_to_Match</bpmn:incoming>
      <bpmn:outgoing>Flow_Match_to_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ClearingMatched" name="Clearing matched?" default="Flow_Matched">
      <bpmn:incoming>Flow_Match_to_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Matched</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotMatched</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_DebitCardholderAccount" name="Debit cardholder account">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="debit-cardholder-account" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Matched</bpmn:incoming>
      <bpmn:outgoing>Flow_Debit_to_Credit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CreditMerchantAccount" name="Credit merchant account">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="credit-merchant-account" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Debit_to_Credit</bpmn:incoming>
      <bpmn:outgoing>Flow_Credit_to_Advice</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendSettlementAdvice" name="Send settlement advice">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-settlement-advice" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Credit_to_Advice</bpmn:incoming>
      <bpmn:outgoing>Flow_Advice_to_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_SettlementComplete" name="Settlement complete">
      <bpmn:incoming>Flow_1m1h5yw</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_InvestigateClearingMismatch" name="Investigate clearing mismatch">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NotMatched</bpmn:incoming>
      <bpmn:outgoing>Flow_Investigate_to_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_ClearingMismatch" name="Clearing mismatch investigated">
      <bpmn:incoming>Flow_Investigate_to_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_RejectClearingRecord" name="Reject clearing record" isForCompensation="true">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reject-clearing-record" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ReverseCardholderDebit" name="Reverse cardholder debit" isForCompensation="true">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reverse-cardholder-debit" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ReverseMerchantCredit" name="Reverse merchant credit" isForCompensation="true">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reverse-merchant-credit" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BoundaryEvent_DebitFailed" name="Settlement failed" attachedToRef="Task_DebitCardholderAccount">
      <bpmn:outgoing>Flow_DebitError_to_Gateway</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrEvtDef_DebitFailed" errorRef="Error_SettlementFailed" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BoundaryEvent_CreditFailed" name="Settlement failed" attachedToRef="Task_CreditMerchantAccount">
      <bpmn:outgoing>Flow_CreditError_to_Gateway</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrEvtDef_CreditFailed" errorRef="Error_SettlementFailed" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_SettlementFailure" name="">
      <bpmn:incoming>Flow_DebitError_to_Gateway</bpmn:incoming>
      <bpmn:incoming>Flow_CreditError_to_Gateway</bpmn:incoming>
      <bpmn:incoming>Flow_0stty6e</bpmn:incoming>
      <bpmn:outgoing>Flow_Failure_to_Notify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_NotifySettlementFailure" name="Notify settlement failure">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-settlement-failure" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Failure_to_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify_to_CompThrow</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="IntThrow_Compensate" name="Trigger compensation">
      <bpmn:incoming>Flow_Notify_to_CompThrow</bpmn:incoming>
      <bpmn:outgoing>Flow_CompThrow_to_End</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="CompEvtDef_Throw" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="EndEvent_SettlementFailed" name="Settlement failed - compensated">
      <bpmn:incoming>Flow_CompThrow_to_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_to_Match" sourceRef="StartEvent_ClearingBatchReceived" targetRef="Task_MatchClearingRecord" />
    <bpmn:sequenceFlow id="Flow_Match_to_Gateway" sourceRef="Task_MatchClearingRecord" targetRef="Gateway_ClearingMatched" />
    <bpmn:sequenceFlow id="Flow_Matched" name="Yes" sourceRef="Gateway_ClearingMatched" targetRef="Task_DebitCardholderAccount" />
    <bpmn:sequenceFlow id="Flow_NotMatched" name="No" sourceRef="Gateway_ClearingMatched" targetRef="Task_InvestigateClearingMismatch">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=if is defined(clearingMatched) then not(clearingMatched) else false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Investigate_to_End" sourceRef="Task_InvestigateClearingMismatch" targetRef="EndEvent_ClearingMismatch" />
    <bpmn:sequenceFlow id="Flow_Debit_to_Credit" sourceRef="Task_DebitCardholderAccount" targetRef="Task_CreditMerchantAccount" />
    <bpmn:sequenceFlow id="Flow_Credit_to_Advice" sourceRef="Task_CreditMerchantAccount" targetRef="Task_SendSettlementAdvice" />
    <bpmn:sequenceFlow id="Flow_Advice_to_End" sourceRef="Task_SendSettlementAdvice" targetRef="Gateway_0li6edd" />
    <bpmn:sequenceFlow id="Flow_DebitError_to_Gateway" sourceRef="BoundaryEvent_DebitFailed" targetRef="Gateway_SettlementFailure" />
    <bpmn:sequenceFlow id="Flow_CreditError_to_Gateway" sourceRef="BoundaryEvent_CreditFailed" targetRef="Gateway_SettlementFailure" />
    <bpmn:sequenceFlow id="Flow_Failure_to_Notify" sourceRef="Gateway_SettlementFailure" targetRef="Task_NotifySettlementFailure" />
    <bpmn:sequenceFlow id="Flow_Notify_to_CompThrow" sourceRef="Task_NotifySettlementFailure" targetRef="IntThrow_Compensate" />
    <bpmn:sequenceFlow id="Flow_CompThrow_to_End" sourceRef="IntThrow_Compensate" targetRef="EndEvent_SettlementFailed" />
    <bpmn:boundaryEvent id="BoundaryEvent_CompMatch" name="Compensate match" attachedToRef="Task_MatchClearingRecord">
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_0qwy1rj" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BoundaryEvent_CompDebit" name="Compensate debit" attachedToRef="Task_DebitCardholderAccount">
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_1nouet7" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BoundaryEvent_CompCredit" name="Compensate credit" attachedToRef="Task_CreditMerchantAccount">
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_00pu31l" />
    </bpmn:boundaryEvent>
    <bpmn:startEvent id="StartEvent_ClearingBatchReceived" name="Clearing batch received">
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="correlationKey" value="rrn" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Start_to_Match</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_0li6edd" name="Send Settlement Advice Success?" default="Flow_1m1h5yw">
      <bpmn:incoming>Flow_Advice_to_End</bpmn:incoming>
      <bpmn:outgoing>Flow_1m1h5yw</bpmn:outgoing>
      <bpmn:outgoing>Flow_0stty6e</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1m1h5yw" name="yes" sourceRef="Gateway_0li6edd" targetRef="EndEvent_SettlementComplete" />
    <bpmn:sequenceFlow id="Flow_0stty6e" name="no" sourceRef="Gateway_0li6edd" targetRef="Gateway_SettlementFailure">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=if is defined(settlmentAdviceSent) then settlmentAdviceSent else true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:association id="Association_0h4v3wb" associationDirection="One" sourceRef="BoundaryEvent_CompMatch" targetRef="Task_RejectClearingRecord" />
    <bpmn:association id="Association_0z54oab" associationDirection="One" sourceRef="BoundaryEvent_CompDebit" targetRef="Task_ReverseCardholderDebit" />
    <bpmn:association id="Association_0570jws" associationDirection="One" sourceRef="BoundaryEvent_CompCredit" targetRef="Task_ReverseMerchantCredit" />
  </bpmn:process>
