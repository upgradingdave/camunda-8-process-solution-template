  <bpmn:process id="Process_1piwalf" name="Hybrid Connector Demo" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Start from Local" zeebe:modelerTemplate="Template_0sjlx1z" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="inbound.type" value="io.camunda:webhook:local" />
          <zeebe:property name="inbound.method" value="any" />
          <zeebe:property name="inbound.context" value="catFact" />
          <zeebe:property name="inbound.shouldValidateHmac" value="disabled" />
          <zeebe:property name="inbound.auth.type" value="NONE" />
          <zeebe:property name="consumeUnmatchedEvents" value="true" />
          <zeebe:property name="synchronousResponse" value="false" />
          <zeebe:property name="deduplicationModeManualFlag" value="false" />
          <zeebe:property name="deduplicationMode" value="AUTO" />
          <zeebe:property name="resultVariable" value="" />
          <zeebe:property name="resultExpression" value="" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_164vk4p</bpmn:outgoing>
