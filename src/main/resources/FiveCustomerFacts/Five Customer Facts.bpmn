<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="12675f5" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="Process_fiveCustomerFacts" name="Long Term Memory" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="1.0" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_04nyop6" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1no07az</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1no07az" sourceRef="StartEvent_1" targetRef="Gateway_0coazit" />
    <bpmn:endEvent id="Event_1thij9h">
      <bpmn:incoming>Flow_16engg4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1us1pez" sourceRef="Activity_02w2lo9" targetRef="Activity_1f8rlnx" />
    <bpmn:adHocSubProcess id="Activity_02w2lo9" name="Learn about Customer" zeebe:modelerTemplate="io.camunda.connectors.agenticai.aiagent.jobworker.v1" zeebe:modelerTemplateVersion="7" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent-job-worker:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="bedrock" target="provider.type" />
          <zeebe:input source="{{secrets.AWS_REGION}}" target="provider.bedrock.region" />
          <zeebe:input source="credentials" target="provider.bedrock.authentication.type" />
          <zeebe:input source="{{secrets.AWS_ACCESS_KEY}}" target="provider.bedrock.authentication.accessKey" />
          <zeebe:input source="{{secrets.AWS_SECRET_KEY}}" target="provider.bedrock.authentication.secretKey" />
          <zeebe:input source="us.anthropic.claude-sonnet-4-6" target="provider.bedrock.model.model" />
          <zeebe:input source="=&#34;&#10;Your goal is to ensure you know exactly 5 unique facts about the current customer.&#10;&#10;## STEP 0 — EXTRACT FACTS FROM PRIOR CONTEXT (do this before anything else)&#10;&#10;The user prompt may contain output from previous agent interactions, including&#10;&#60;reasoning&#62; blocks, summaries, and conversation history. This content represents&#10;facts already collected in earlier sessions.&#10;&#10;Before doing anything else:&#10;1. Read the entire user prompt carefully.&#10;2. Extract every unique fact about the customer that appears anywhere in the user &#10;   prompt — including inside &#60;reasoning&#62; blocks, inside summary lists, and inside &#10;   any free-form text.&#10;3. Deduplicate the facts. If the same fact appears multiple times in different &#10;   formats, count it only once.&#10;4. Count your total unique facts.&#10;5. Output your mandatory &#60;reasoning&#62; block (see OUTPUT FORMAT below) reflecting &#10;   this starting state, then:&#10;&#10;- If &#60;fact_count&#62; is 5 or more → set &#60;next_action&#62; to STOP_GOAL_REACHED and do &#10;  not call any tool.&#10;- If &#60;fact_count&#62; is less than 5 → set &#60;next_action&#62; to CALL_TOOL and proceed &#10;  to the Core Loop to collect the remaining facts.&#10;&#10;## Core Loop (only enter this if fact_count is less than 5 after STEP 0)&#10;1. Call the &#39;Ask Customer&#39; tool to learn one new fact not already in your list.&#10;2. Add the fact to your running list.&#10;3. Count how many unique facts you have collected so far (including those from STEP 0).&#10;4. If your count is less than 5, go back to step 1 immediately — do NOT pause, &#10;   summarize, or wait.&#10;5. Only stop calling tools when your count equals 5.&#10;&#10;## Rules&#10;- Facts extracted from the user prompt in STEP 0 count toward your total of 5.&#10;- Do NOT ask the customer about facts you already know from prior context.&#10;- You MUST call &#39;Ask Customer&#39; repeatedly until you reach 5 total unique facts.&#10;- A fact is only counted once, even if it appears multiple times in the user prompt &#10;  or the customer repeats themselves.&#10;- Do NOT stop after 1 new fact. Only stop when your total (prior + new) equals 5.&#10;- You can and should call the same tool multiple times.&#10;- Do not guess or invoke tools that were not explicitly configured. If no tool &#10;  matches a request, exit.&#10;- If the customer indicates they want to end the conversation at any point, stop &#10;  collecting and return a summary of all facts known so far.&#10;&#10;## OUTPUT FORMAT — THIS IS MANDATORY&#10;&#10;Every single response you produce — without exception — MUST begin with the following&#10;XML block. Do not write any text before it. Do not skip it. Do not abbreviate it.&#10;If this block is missing from your response, your output is invalid.&#10;&#10;&#60;reasoning&#62;&#10;  &#60;facts_collected&#62;&#10;    1. [first fact, or \&#34;none yet\&#34;]&#10;    2. [second fact, or \&#34;none yet\&#34;]&#10;    3. [third fact, or \&#34;none yet\&#34;]&#10;    4. [fourth fact, or \&#34;none yet\&#34;]&#10;    5. [fifth fact, or \&#34;none yet\&#34;]&#10;  &#60;/facts_collected&#62;&#10;  &#60;facts_from_prior_context&#62;[number of facts extracted from the user prompt in STEP 0]&#60;/facts_from_prior_context&#62;&#10;  &#60;facts_from_current_session&#62;[number of new facts collected via Ask Customer this session]&#60;/facts_from_current_session&#62;&#10;  &#60;fact_count&#62;[total unique facts, 0–5]&#60;/fact_count&#62;&#10;  &#60;goal_reached&#62;[true or false]&#60;/goal_reached&#62;&#10;  &#60;next_action&#62;[CALL_TOOL or STOP_GOAL_REACHED or STOP_CUSTOMER_EXIT]&#60;/next_action&#62;&#10;&#60;/reasoning&#62;&#10;&#10;After the closing &#60;/reasoning&#62; tag, write your response to the customer.&#10;Only set &#60;next_action&#62; to STOP_GOAL_REACHED when &#60;fact_count&#62; is 5 or more.&#10;&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=(&#10;  if previousCustomerFacts != null and &#10;    previousCustomerFacts.chunks != null then&#10;      string join(previousCustomerFacts.chunks.content, &#34; &#34;)&#10;  else&#10;    &#34;No facts are known yet about about this customer&#34;&#10;)" target="data.userPrompt.prompt" />
          <zeebe:input source="=agent.context" target="agentContext" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="=10" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=true" target="data.response.includeAssistantMessage" />
          <zeebe:input source="=true" target="data.response.includeAgentContext" />
          <zeebe:input target="agent" />
          <zeebe:output source="=agent" target="agent" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="7" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.aiagent.jobworker.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult&#10;}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_14xxtl9</bpmn:incoming>
      <bpmn:outgoing>Flow_1us1pez</bpmn:outgoing>
      <bpmn:userTask id="Activity_06a9rkf" name="Ask Customer">
        <bpmn:documentation>Use this tool to discover a fact about a customer</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="ask-customer-0o0oucp" />
          <zeebe:ioMapping>
            <zeebe:output source="=customerFact" target="toolCallResult" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:userTask>
    </bpmn:adHocSubProcess>
    <bpmn:sequenceFlow id="Flow_05zyuch" sourceRef="Activity_1f8rlnx" targetRef="Activity_0jy19ut" />
    <bpmn:serviceTask id="Activity_1f8rlnx" name="Save Customer Facts" zeebe:modelerTemplate="io.camunda.connectors.EmbeddingsVectorDB.v1" zeebe:modelerTemplateVersion="2" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:embeddings-vector-database:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="embedDocumentOperation" target="vectorDatabaseConnectorOperation.operationType" />
          <zeebe:input source="bedrockModelProvider" target="embeddingModelProvider.modelProvider" />
          <zeebe:input source="{{secrets.AWS_ACCESS_KEY}}" target="embeddingModelProvider.bedrock.accessKey" />
          <zeebe:input source="{{secrets.AWS_SECRET_KEY}}" target="embeddingModelProvider.bedrock.secretKey" />
          <zeebe:input source="{{secrets.AWS_REGION}}" target="embeddingModelProvider.bedrock.region" />
          <zeebe:input source="TitanEmbedTextV2" target="embeddingModelProvider.bedrock.modelName" />
          <zeebe:input source="D1024" target="embeddingModelProvider.bedrock.dimensions" />
          <zeebe:input source="=false" target="embeddingModelProvider.bedrock.normalize" />
          <zeebe:input source="=3" target="embeddingModelProvider.bedrock.maxRetries" />
          <zeebe:input source="elasticsearchStore" target="vectorStore.storeType" />
          <zeebe:input source="http://camunda-elasticsearch:9200" target="vectorStore.elasticsearch.baseUrl" />
          <zeebe:input source="=&#34;elastic&#34;" target="vectorStore.elasticsearch.userName" />
          <zeebe:input source="=&#34;elastic&#34;" target="vectorStore.elasticsearch.password" />
          <zeebe:input source="=&#34;conversation-&#34; + customerEmail" target="vectorStore.elasticsearch.indexName" />
          <zeebe:input source="PlainText" target="vectorDatabaseConnectorOperation.documentSource" />
          <zeebe:input source="=agent.responseText" target="vectorDatabaseConnectorOperation.documentSourceFromProcessVariable" />
          <zeebe:input source="noopDocumentSplitter" target="vectorDatabaseConnectorOperation.documentSplitter.splitterType" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="2" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.EmbeddingsVectorDB.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1us1pez</bpmn:incoming>
      <bpmn:outgoing>Flow_05zyuch</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_036rkpe" name="Query Customer Facts" zeebe:modelerTemplate="io.camunda.connectors.EmbeddingsVectorDB.v1" zeebe:modelerTemplateVersion="2" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:embeddings-vector-database:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="retrieveDocumentOperation" target="vectorDatabaseConnectorOperation.operationType" />
          <zeebe:input source="=&#34;What are 5 facts about this customer?&#34;" target="vectorDatabaseConnectorOperation.query" />
          <zeebe:input source="=5" target="vectorDatabaseConnectorOperation.documentLimit" />
          <zeebe:input source="bedrockModelProvider" target="embeddingModelProvider.modelProvider" />
          <zeebe:input source="{{secrets.AWS_ACCESS_KEY}}" target="embeddingModelProvider.bedrock.accessKey" />
          <zeebe:input source="{{secrets.AWS_SECRET_KEY}}" target="embeddingModelProvider.bedrock.secretKey" />
          <zeebe:input source="{{secrets.AWS_REGION}}" target="embeddingModelProvider.bedrock.region" />
          <zeebe:input source="TitanEmbedTextV2" target="embeddingModelProvider.bedrock.modelName" />
          <zeebe:input source="D1024" target="embeddingModelProvider.bedrock.dimensions" />
          <zeebe:input source="=false" target="embeddingModelProvider.bedrock.normalize" />
          <zeebe:input source="=3" target="embeddingModelProvider.bedrock.maxRetries" />
          <zeebe:input source="elasticsearchStore" target="vectorStore.storeType" />
          <zeebe:input source="http://camunda-elasticsearch:9200" target="vectorStore.elasticsearch.baseUrl" />
          <zeebe:input source="=&#34;elastic&#34;" target="vectorStore.elasticsearch.userName" />
          <zeebe:input source="=&#34;elastic&#34;" target="vectorStore.elasticsearch.password" />
          <zeebe:input source="=&#34;conversation-&#34; + customerEmail" target="vectorStore.elasticsearch.indexName" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="2" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.EmbeddingsVectorDB.v1" />
          <zeebe:header key="resultVariable" value="previousCustomerFacts" />
          <zeebe:header key="errorExpression" value="=if contains(error.message, &#34;index_not_found&#34;) then bpmnError(&#34;index_not_found&#34;, &#34;The index does not exist&#34;) else null" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1itajb7</bpmn:incoming>
      <bpmn:outgoing>Flow_0y9m7d0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0y9m7d0" sourceRef="Activity_036rkpe" targetRef="Gateway_1h5iqz7" />
    <bpmn:boundaryEvent id="Event_0n361l6" name="No customer facts found" attachedToRef="Activity_036rkpe">
      <bpmn:outgoing>Flow_1sqloxj</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_05av2rm" errorRef="Error_0vb336i" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_1h5iqz7">
      <bpmn:incoming>Flow_0y9m7d0</bpmn:incoming>
      <bpmn:incoming>Flow_1sqloxj</bpmn:incoming>
      <bpmn:outgoing>Flow_14xxtl9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_14xxtl9" sourceRef="Gateway_1h5iqz7" targetRef="Activity_02w2lo9" />
    <bpmn:sequenceFlow id="Flow_1sqloxj" sourceRef="Event_0n361l6" targetRef="Gateway_1h5iqz7" />
    <bpmn:exclusiveGateway id="Gateway_0coazit" name="Customer Email?" default="Flow_0lt0znb">
      <bpmn:incoming>Flow_1no07az</bpmn:incoming>
      <bpmn:outgoing>Flow_1itajb7</bpmn:outgoing>
      <bpmn:outgoing>Flow_0lt0znb</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1itajb7" name="Yes" sourceRef="Gateway_0coazit" targetRef="Activity_036rkpe">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=customerEmail != null and customerEmail != ""</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_0bjfuut" name="Email Address Required">
      <bpmn:incoming>Flow_0lt0znb</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0lt0znb" name="No" sourceRef="Gateway_0coazit" targetRef="Event_0bjfuut" />
    <bpmn:sequenceFlow id="Flow_16engg4" sourceRef="Activity_05bw27t" targetRef="Event_1thij9h" />
    <bpmn:userTask id="Activity_05bw27t" name="Summary">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="summary-0lxturw" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0kedm5o</bpmn:incoming>
      <bpmn:outgoing>Flow_16engg4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0kedm5o" sourceRef="Activity_0jy19ut" targetRef="Activity_05bw27t" />
    <bpmn:scriptTask id="Activity_0jy19ut" name="Format Summary">
      <bpmn:extensionElements>
        <zeebe:script expression="=(for line in split(substring before(substring after(agent.responseText, &#34;&#60;facts_collected&#62;&#34;), &#34;&#60;/facts_collected&#62;&#34;), &#34;\n&#34;)&#10;return {&#34;fact&#34;: &#10;    if contains(line, &#34;. &#34;) then substring after(line, &#34;. &#34;)&#10;    else null }&#10;)[item.fact != null]" resultVariable="customerFacts" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05zyuch</bpmn:incoming>
      <bpmn:outgoing>Flow_0kedm5o</bpmn:outgoing>
    </bpmn:scriptTask>
  </bpmn:process>
  <bpmn:error id="Error_0vb336i" name="index_not_found" errorCode="index_not_found" />
